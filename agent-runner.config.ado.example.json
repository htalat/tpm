{
  "syncIntervalMs": 60000,
  "runsDir": "data/agent-runs",
  "repos": [
    {
      "name": "contoso/Web/website",
      "tracker": "azure-boards",
      "host": "ado",
      "ado": {
        "organization": "contoso",
        "project": "Web",
        "repository": "website",
