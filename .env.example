# PostgreSQL connection (matches docker-compose.yml)
DATABASE_URL=postgres://durable:durable@localhost:5432/durable
TEST_DATABASE_URL=postgres://durable:durable@localhost:5432/durable_test

# API
API_PORT=3000
API_URL=http://localhost:3000
# Optional shared secrets. Empty = disabled (local development only).
API_TOKEN=
WORKER_TOKEN=

# Orchestrator
ORCHESTRATOR_POLL_MS=200
ORCHESTRATOR_METRICS_PORT=9464

# Worker
WORKER_CAPABILITIES=compute,aggregate,flaky,slow,side-effect,agent,reserve,charge,ship,release,refund,publish
WORKER_CONCURRENCY=4
LEASE_MS=10000

# Logging: trace | debug | info | warn | error
LOG_LEVEL=info

# Failure injection, e.g. CRASH_AT=AFTER_SIDE_EFFECT or CRASH_AT=AFTER_WORK_CLAIMED:2
CRASH_AT=
